#**********************************************************************#
#  .gitignore for bitwhiz (Fortran, gfortran, make, macOS)             #
#                                                                      #
#  Rule of thumb: commit what a person writes; ignore what the build   #
#  or a run writes. Anything below can be regenerated with 'make' or   #
#  by re-running the code.                                             #
#                                                                      #
#  NOTE: .gitignore only affects files git is NOT already tracking.    #
#  To stop tracking a file that was committed earlier:                 #
#     git rm --cached <file>      (keeps your local copy)              #
#**********************************************************************#

# ---- Fortran build products ------------------------------------------
*.o
*.mod
*.smod
*.a
*.so
*.dylib
*.d

# ---- Executables -----------------------------------------------------
# bin/ holds the built program(s); keep only its README.
bin/*
!bin/README.md
*.out
*.exe
*.dSYM/

# ---- Out-of-tree build and run directories (if used) ----------------
build/
runs/

# ---- Generated source --------------------------------------------------
# Written by src/utils/make_build_info.sh on every 'make'.
src/modules/build_mod.f95

# ---- Run outputs ------------------------------------------------------
# Every run writes <title>.heartbeat in the folder it runs from, and
# <title>.tracers.csv when the deck has tracers, and <title>.hist when it
# has snapshots (plot_every or plot_dt), and <title>.resolved, the
# resolved deck (every run that reads its deck cleanly).
*.heartbeat
*.tracers.csv
*.hist
*.resolved

# ---- LaTeX build products (doc/) ------------------------------------
# doc/ keeps each sheet's .tex and .pdf, and the figure .tex and .pdf
# files the sheet needs; rebuilding it there writes these, which are not
# kept.
*.aux
*.log
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# ---- Generated images ------------------------------------------------
# Bitmaps are outputs; they can be recreated from the code. To commit
# a specific one on purpose (e.g. a README figure), whitelist it:
#     !docs/example.bmp
*.bmp

# ---- macOS -----------------------------------------------------------
.DS_Store
._*

# ---- Editors (vi/vim, emacs, VS Code) -------------------------------
*.swp
*.swo
*~
\#*\#
.vscode/

# ---- Python helper scripts -------------------------------------------
__pycache__/
*.pyc
