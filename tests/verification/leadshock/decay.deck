#**********************************************************************#
#  Lead-shock study, a decaying shock (../study_leadshock.py, set C):  #
#  a thin flyer, so its release overtakes the shock in the target and #
#  the lead shock weakens with depth (Menikoff and Shaw 2010, Fig. 3). #
#                                                                      #
#      Al flyer, 0.25 mm at 2.00 km/s ->  Al target, 8 mm, at rest     #
#                    x = 0 at the impact plane                         #
#                                                                      #
#  Until the release catches the shock, its particle velocity is u_p = #
#  1.00 km/s exactly (P1 = 18.459 GPa, Us = 6.64 km/s), the square     #
#  shock of ../av_study/fs_square.deck; then P_s falls with depth.     #
#  Tracers at 0.5, 1, 2, 3, 4 and 6 mm. Units: mm, us, g/cc, km/s, GPa.#
#**********************************************************************#
Begin bitwhiz
 deck_version = 1

 Begin Run
  title = decay
  t_end = 1.15                  # us: the shock reaches 6 mm at 0.9 us,
                                # the free surface (8 mm) after 1.2
 End Run

 Begin Output
  tracer_dt = 0                 # every cycle: the detector's replay
  plot_dt   = 2.0
  tracer = d05    T@0.0625      # 0.5 mm deep
  tracer = d1     T@0.125
  tracer = d2     T@0.25
  tracer = d3     T@0.375
  tracer = d4     T@0.5
  tracer = d6     T@0.75
 End Output

 Begin Solver
  method = AV
 End Solver

 Begin Material Al              # aluminum (the ME 697 class deck's values)
  R0 = 2.78
  C0 = 5.30
  S1 = 1.34
  G0 = 2.00
  spall_strength = 100          # GPa: spall off (the study ends before
                                # the free surface)
 End Material

 Begin Stack
  resolution = 25               # zones/mm (study_leadshock.py sets it)
  origin     = F:T              # x = 0 at the impact plane

  Begin Layer
   name     = F
   material = Al
   width    = 0.25              # mm
   xvel     = 2.0               # km/s
  End Layer

  Begin Layer
   name     = T
   material = Al
   width    = 8.0               # at rest
  End Layer
 End Stack
End bitwhiz
