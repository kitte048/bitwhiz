# expect: ok
# Plate impact with spall: Al 1 mm at 0.5 km/s onto Al 2 mm. The two
# release waves meet inside the target and break it (spall_strength
# 1 GPa), about 0.95 mm from the free surface at 0.54 us. Used by the
# deck tests (read and round trip) and by tests/run_omp_tests.sh
# (threads must give the serial answer while cells are breaking), and,
# with plot_every = 7, by tests/run_hist_tests.sh (frames every 7th
# cycle).
Begin bitwhiz
 deck_version = 1
 Begin Run
  title = plate_spall
  t_end = 1.4
 End Run
 Begin Output
  plot_every = 7
 End Output
 Begin Material Al
  R0 = 2.78
  C0 = 5.30
  S1 = 1.34
  G0 = 2.00
  spall_strength = 1.0
 End Material
 Begin Stack
  resolution = 100
  Begin Layer
   name = flyer
   material = Al
   width = 1.0
   xvel = 0.5
  End Layer
  Begin Layer
   name = target
   material = Al
   width = 2.0
  End Layer
 End Stack
End bitwhiz
