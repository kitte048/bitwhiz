#**********************************************************************#
#  Ramp drive from a velocity profile: sinh-arcsinh.                   #
#                                                                      #
#  A skewed profile with a long tail: sinh_arcsinh, center -0.1 of     #
#  A's width (just behind its back), spread 0.25, skewness eps = 1.0   #
#  (the tail reaches toward the contact), delta = 1.0. A's front       #
#  still moves at 0.32 km/s, so B first takes a small shock (the       #
#  foot), then a ramp about 0.5 us long as A's faster back arrives:    #
#  the shape of many ramp-wave drives. eps sets how long the tail is,  #
#  delta how fast it falls: the kind of handles an inverse problem     #
#  would turn to match a measured drive (a Z-machine ramp wave, say).  #
#                                                                      #
#  One of four decks with a different profile each: ramp_linear,       #
#  ramp_beta, ramp_sinh_arcsinh, pulse_split_normal (input/README.md,  #
#  Layer block). Units: mm, us, g/cc, km/s, GPa. Later, A breaks near  #
#  its back (spall): the default spall strength, 0.01 GPa, is low.     #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1

 Begin Run
  title = ramp_sinh_arcsinh
  t_end = 4.0                   # us: the ramp crosses B and reaches its
                                # free surface
 End Run

 Begin Output
  plot_dt   = 0.01              # us between snapshots
  tracer_dt = 0.005             # us between tracer rows
  colormap  = viridis

  tracer = drive  A:B           # the interface: the drive B feels
  tracer = mid_b  B@0.5         # halfway through B
  tracer = fs     B@1           # B's free surface
 End Output

 Begin Solver
  method = AV
 End Solver

 Begin Material Al              # aluminum (the ME 697 class deck's values)
  R0 = 2.78
  C0 = 5.30
  S1 = 1.34
  G0 = 2.00
 End Material

 Begin Material PMMA            # window; Lacina et al. (2018) linear fit
  R0 = 1.187
  C0 = 2.55
  S1 = 1.54
  G0 = 0.90                     # (the ME 697 class deck's values)
 End Material

 Begin Stack
  resolution = 25               # zones/mm: 100 + 250 = 350 cells
  origin     = A:B              # x = 0 at the contact

  Begin Layer
   name     = A
   material = Al
   width    = 4.0               # mm
   xvel           = 1.0         # km/s: A's mean velocity (its momentum)
   xvel_profile   = sinh_arcsinh -0.1 0.25 1.0 1.0  # a long tail toward B
  End Layer

  Begin Layer
   name     = B
   material = PMMA
   width    = 10.0              # at rest
  End Layer
 End Stack
End bitwhiz
