#**********************************************************************#
#  A velocity pulse inside a layer: split normal.                      #
#                                                                      #
#  Layer A is at rest on average (xvel = 0) but not still: its         #
#  velocity is a split-normal bump, peaking at 0.75 of its width,      #
#  falling fast toward the contact (spread 0.05) and slowly toward     #
#  its back (0.25), with amplitude 0.6 km/s, so u = 0.6 (f - 1). The   #
#  bump moves right and the rest of A moves left, so A squeezes ahead  #
#  of the bump and stretches behind it: B gets a compression pulse,    #
#  and A goes into tension at once (about 11.4 GPa, far more than real #
#  aluminum holds). Spall is off: see spall_strength below.            #
#                                                                      #
#  One of four decks with a different profile each: ramp_linear,       #
#  ramp_beta, ramp_sinh_arcsinh, pulse_split_normal (input/README.md,  #
#  Layer block). Units: mm, us, g/cc, km/s, GPa.                       #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1

 Begin Run
  title = pulse_split_normal
  t_end = 4.0                   # us: the ramp crosses B and reaches its
                                # free surface
 End Run

 Begin Output
  plot_dt   = 0.01              # us between snapshots
  tracer_dt = 0.005             # us between tracer rows
  colormap  = viridis

  tracer = drive  A:B           # the interface: the drive B feels
  tracer = mid_b  B@0.5         # halfway through B
  tracer = fs     B@1           # B's free surface
 End Output

 Begin Solver
  method = AV
 End Solver

 Begin Material Al              # aluminum (the ME 697 class deck's values)
  R0 = 2.78
  C0 = 5.30
  S1 = 1.34
  G0 = 2.00
  spall_strength = 100          # GPa: spall off. A wave demo, not a
                                # fracture study: this deck pulls A to
                                # about 11.4 GPa of tension; real aluminum
                                # breaks at about 1 to 2 (dynamic)
 End Material

 Begin Material PMMA            # window; Lacina et al. (2018) linear fit
  R0 = 1.187
  C0 = 2.55
  S1 = 1.54
  G0 = 0.90                     # (the ME 697 class deck's values)
  spall_strength = 100          # GPa: spall off. B reaches about 1.1 GPa
                                # of tension; PMMA breaks at about 0.16
                                # (Frawley et al. 2025, J. Dyn. Behav.
                                # Mater., doi:10.1007/s40870-025-00468-8)
 End Material

 Begin Stack
  resolution = 25               # zones/mm: 100 + 250 = 350 cells
  origin     = A:B              # x = 0 at the contact

  Begin Layer
   name     = A
   material = Al
   width    = 4.0               # mm
   xvel           = 0.0         # km/s: A's mean velocity (its momentum)
   xvel_profile   = split_normal 0.75 0.05 0.25  # a bump near B
   xvel_amplitude = 0.6         # km/s: u = 0.6 (f - 1)
  End Layer

  Begin Layer
   name     = B
   material = PMMA
   width    = 10.0              # at rest
  End Layer
 End Stack
End bitwhiz
