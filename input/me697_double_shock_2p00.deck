#**********************************************************************#
#  ME 697 class project, assigned double-shock problem (rev-0, Fig. 1) #
#                                                                      #
#  Ta-backed Al flyer at u_fly  ->  Material X  ->  PMMA window        #
#                                                                      #
#      | Ta 3.0 | Al 4.0 |=> Material X 10.0 | PMMA 10.0 |  PDV ->     #
#     x=-7.0           x=0 (impact plane)    x=10.0      x=20.0        #
#                                                                      #
#  The five cases (1.00, 1.25, 1.50, 1.75, 2.00 km/s) differ only in   #
#  the "define u_fly" line. Syntax: input/README.md (deck_version 1).  #
#  EOS data: project rev-0, Table 1. Units: mm, us, g/cc, km/s, GPa.   #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1
 define u_fly = 2.00            # km/s, flyer velocity

 Begin Run
  plots_only = no    # yes or no
  title       = double_shock_2p00
  t_end       = 5.0             # us. Placeholder: the first shock reaches
                                # PMMA near 2.0 us at 2.00 km/s; set the
                                # final value from the hand t-x diagram.
  num_threads = 1
 End Run

 Begin Output                   # nothing listed here = nothing written
  plot_dt     = 0.005           # us between snapshots: under a
                                # pixel row of the t-x diagrams
  tracer_dt   = 0.005           # us between tracer rows (the
                                # reference's spacing); 0 = every cycle
  colormap    = viridis         # for bitmap pictures

  tracer = pdv     MatX:PMMA    # the PDV signal
  tracer = impact  Al:MatX      # impact plane
  tracer = ta_al   Ta:Al        # where the second shock is born
  tracer = mid_x   MatX@0.5     # mid-sample
 End Output

 Begin Solver
  method = AV
  BL     = 0.1                  # linear viscosity coefficient
  BQ     = 2.0                  # quadratic viscosity coefficient
                                # (the equation sheet's defaults; leave
                                # them alone unless you are studying q)
  CFL    = 0.6
 End Solver

 # Mie-Gruneisen on the principal Hugoniot (rev-0, Eqs. 4 and 6):
 #   Us = C0 + S1*up + (S2/C0)*up^2,   rho*Gamma = R0*G0
 Begin Material Ta              # tantalum, backing plate
  R0 = 16.65                    # g/cm^3, initial density
  C0 = 3.40                     # km/s, Hugoniot intercept
  S1 = 1.20                     # -,    Us-up slope
  S2 = 0.0                      # -,    Us-up curvature (default 0)
  G0 = 1.60                     # -,    Gruneisen coefficient
  spall_strength = 5.0          # GPa, dynamic. Tantalum is strong in
                                # tension (spall strengths of several
                                # GPa are reported); at 5.0 the Ta here
                                # holds its ~2 GPa tension, as in the
                                # reference data. Other materials take
                                # the default, 0.01 GPa (input/README.md)
 End Material

 Begin Material Al              # aluminum, flyer face
  R0 = 2.78
  C0 = 5.30
  S1 = 1.34
  S2 = 0.0
  G0 = 2.00
 End Material

 Begin Material MatX            # notional HE surrogate, inert here
  R0 = 1.60
  C0 = 2.50
  S1 = 1.80
  S2 = -0.10
  G0 = 1.20
 End Material

 Begin Material PMMA            # window; Lacina et al. (2018) linear fit
  R0 = 1.187
  C0 = 2.55
  S1 = 1.54
  S2 = 0.0
  G0 = 0.90                     # estimated from Plexiglass (rev-0 Table 1)
 End Material

 Begin Stack
  resolution = 35               # zones/mm: 105 + 140 + 350 + 350 = 945
  origin     = Al:MatX          # x = 0 at the impact plane

  Begin Layer
   material = Ta
   width    = 3.0               # mm
   xvel     = u_fly             # km/s, + is to the right
  End Layer

  Begin Layer
   material = Al
   width    = 4.0
   xvel     = u_fly
  End Layer

  Begin Layer
   material = MatX
   width    = 10.0
  End Layer

  Begin Layer
   material = PMMA
   width    = 10.0
  End Layer
 End Stack
End bitwhiz

Notes (ignored by the parser):
- Convergence study: change "resolution = 35" to 17.5 and 8.75.
- Velocity sweep: change "define u_fly" only.

#**********************************************************************#
#  KEY REFERENCE (deck_version 1): every key, its default, its options #
#  Details and examples: input/README.md, sections 6 to 9b. Names and  #
#  values ignore case; units are mm, us, g/cm^3, km/s, GPa.            #
#**********************************************************************#
#  Top level
#    deck_version   1 (required)
#    define         <name> = <number>; use the name as a value later
#
#  Begin Run
#    title          name of the run's files     (default: the deck's name)
#    t_end          us, end time                (required)
#    cycle_max      cycles, a backstop          (1000000)
#    num_threads    0 = all processors          (1)
#    omp_min_zones  fewer cells run on 1 thread (2000; 0 = always thread)
#    plots_only     yes | no: yes skips the run and re-draws the
#                   pictures from this deck's earlier files  (no)
#
#  Begin Output     (nothing listed = nothing written but the heartbeat)
#    tracer         <name> <location>, repeatable; locations:
#                     A:B    the interface of neighboring layers A, B
#                     A@f    fraction f across layer A (0 left, 1 right)
#                     12.3   an x position, mm
#    tracer_dt      us between tracer rows      (0 = every cycle)
#    plot_dt        us between snapshots        (0 = off)
#    plot_every     cycles between snapshots    (0 = off)
#                   either one on writes <title>.hist and the t-x
#                   pictures <title>.tx_u.bmp, <title>.tx_p.bmp
#    colormap       viridis (default), plasma, inferno, blackbody,
#                   kindlmann, extendedkindlmann, smoothcoolwarm,
#                   bentcoolwarm, grayscale
#    plot_range     robust (default): colors from the min to the top
#                   the run held for 50 cycles (a start-up spike does
#                   not set them) | full: from the min to the max
#    plot_u_lo      u color window, fraction 0 to 1 of the u range (0)
#    plot_u_hi                                                      (1)
#    plot_p_lo      P color window, fraction 0 to 1 of the P range (0)
#    plot_p_hi                                                      (1)
#
#  Begin Solver
#    method         AV (artificial viscosity, default) | RS (Riemann)
#    order          RS only: 2 (MUSCL-Hancock, Van Leer, default) | 1
#    BL             AV only, linear viscosity coefficient     (0.1)
#    BQ             AV only, quadratic viscosity coefficient  (2.0)
#    CFL            Courant safety factor, 0 < CFL <= 1       (0.6)
#
#  Begin Material <name>
#    R0, C0, S1, G0 g/cm^3, km/s, -, -          (required)
#    S2             -                           (0.0)
#    spall_strength GPa, tension held before a cell breaks (0.01)
#
#  Begin Stack
#    resolution     zones/mm for every layer    (none: each layer's own)
#    origin         x = 0 at a location (A:B or A@f), or
#    x_left         mm, x of the left face      (0.0; not with origin)
#    Begin Layer    (left to right, all in contact)
#      material     a Material block's name     (required)
#      name         the layer's own name        (the material's; required
#                                                if a material is used twice)
#      width        mm                          (required)
#      xvel         km/s, + is to the right     (0.0)
#      zones        cells in this layer         (or from a resolution)
#      resolution   zones/mm, overrides the Stack's
#**********************************************************************#
