#**********************************************************************#
#  U6 example 1: boundary-boundary interaction (symmetric impact)      #
#                                                                      #
#  Flyer A (2024 Al, 1.0 km/s) strikes target B (2024 Al, at rest).    #
#  U6 equation sheet, Figs. 1-3: one shock state on both sides of the  #
#  impact plane, from the impact match P_A(u_0A - u_1) = P_B(u_1):     #
#                                                                      #
#     u_1 = 0.500 km/s,  P_1 = 8.351 GPa                               #
#     U_LAB,B = +5.997 km/s,  U_LAB,A = -4.997 km/s                    #
#                                                                      #
#      | A (flyer) 3.0 =>| B (target) 6.0 |                            #
#     x=-3.0         x=0 (impact)       x=6.0                          #
#                                                                      #
#  Here t = 0 is the impact (t = 1.5 us in the sheet's Fig. 3, where   #
#  the flyer first closes a gap). After the sheet's window: the shock  #
#  reaches B's free surface at t = 1.0 us (u jumps to 1.0 km/s, about  #
#  2 u_1), and the releases from the two free surfaces meet inside B,  #
#  3 mm from the impact plane, at t = 1.5 us; B spalls there.          #
#                                                                      #
#  Hugoniot: the U6 sheet's values.                                    #
#  Units: mm, us, g/cc, km/s, GPa. Syntax: input/README.md.            #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1
 define u_0A = 1.0              # km/s, flyer velocity

 Begin Run
  title = u6_boundary_boundary
  t_end = 2.5                   # us: impact, both free surfaces, spall
 End Run

 Begin Output
  plot_dt   = 0.005             # us between snapshots
  tracer_dt = 0.005             # us between tracer rows
  colormap  = viridis

  tracer = impact  A:B          # u_1 = 0.500 km/s, P_1 = 8.351 GPa
  tracer = mid_a   A@0.5        # state 1 in A, until the release
  tracer = mid_b   B@0.5        # state 1 in B; the spall plane
  tracer = fs      B@1          # free surface: 2 u_1 = 1.0 km/s
 End Output

 Begin Solver
  method = AV
 End Solver

 Begin Material Al2024          # 2024 aluminum, the U6 sheet's Hugoniot
  R0 = 2.785
  C0 = 5.328
  S1 = 1.338
  G0 = 2.00
  spall_strength = 1.0          # GPa, a round value for aluminum alloys.
                                # At the default (0.01 GPa) the free
                                # surfaces break off a few cells as they
                                # release (the AV overshoot), and those
                                # fly off as debris.
 End Material

 Begin Stack
  resolution = 25               # zones/mm: 75 + 150 = 225 cells
  origin     = A:B              # x = 0 at the impact plane

  Begin Layer
   name     = A
   material = Al2024
   width    = 3.0
   xvel     = u_0A
  End Layer

  Begin Layer
   name     = B
   material = Al2024
   width    = 6.0               # at rest
  End Layer
 End Stack
End bitwhiz
