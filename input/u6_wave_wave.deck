#**********************************************************************#
#  U6 example 4: wave-wave interaction (head-on shocks in 2024 Al)     #
#                                                                      #
#  Shock 1 runs right (u_1 = +0.5 km/s, P_1 = 8.351 GPa) and shock 2   #
#  runs left (u_2 = -0.6 km/s, P_2 = 10.245 GPa) through 2024 Al at    #
#  rest ("A"). They collide at x = 10 mm, t = 1.50 us. U6 equation     #
#  sheet, Figs. 8-10; the congruent mirrored Hugoniots give            #
#                                                                      #
#     u_3 = u_1 + u_2 = -0.100 km/s,  P_3 = 20.83 GPa                  #
#                                                                      #
#  (the exact Mie-Gruneisen reshocks give P_3 = 20.81 GPa, which is    #
#  what bitwhiz computes). The stronger left-running shock wins: the   #
#  collided material drifts left, and the contact leans left.          #
#                                                                      #
#  Three slabs make the two shocks: drivers of the same 2024 Al strike #
#  A from both sides at t = 0, at 2u_1 = +1.0 and 2u_2 = -1.2 km/s     #
#  (symmetric impacts give u_1 and u_2 exactly). The impact planes,    #
#  x = 1.0 and 19.2 mm, are placed so that the shocks (U_1 = 5.997,    #
#  U_2 = 6.131 km/s) meet at x = 10 at t = 1.50 us, as in Fig. 10.     #
#                                                                      #
#      | left 10.0 =>| A 18.2 (at rest) |<= right 10.0 |               #
#     x=-9.0       x=1.0              x=19.2         x=29.2            #
#                                                                      #
#  colormap: a diverging map, so that u > 0 and u < 0 read apart in    #
#  the u t-x diagram. Hugoniot: the U6 sheet's values.                 #
#  Units: mm, us, g/cc, km/s, GPa. Syntax: input/README.md.            #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1
 define u_left  =  1.0          # km/s, left driver:  2 u_1, u_1 = +0.5
 define u_right = -1.2          # km/s, right driver: 2 u_2, u_2 = -0.6

 Begin Run
  title = u6_wave_wave
  t_end = 2.8                   # us, the sheet's Fig. 10 window
 End Run

 Begin Output
  plot_dt   = 0.005             # us between snapshots
  tracer_dt = 0.005             # us between tracer rows
  colormap  = smoothcoolwarm

  tracer = left     A@0.25      # x = 5.55: u_1, then u_3
  tracer = collide  10.0        # the collision point: u_3 from 1.50 us
  tracer = right    A@0.75      # x = 14.65: u_2, then u_3
 End Output

 Begin Solver
  method = AV
 End Solver

 Begin Material Al2024          # 2024 aluminum, the U6 sheet's Hugoniot
  R0 = 2.785
  C0 = 5.328
  S1 = 1.338
  G0 = 2.00
  spall_strength = 1.0          # GPa, a round value for aluminum alloys.
                                # At the default (0.01 GPa) the free
                                # surfaces break off a few cells as they
                                # release (the AV overshoot), and those
                                # fly off as debris.
 End Material

 Begin Stack
  resolution = 25               # zones/mm: 250 + 455 + 250 = 955 cells
  x_left     = -9.0             # left:A at x = 1.0, A:right at x = 19.2

  Begin Layer
   name     = left
   material = Al2024
   width    = 10.0
   xvel     = u_left
  End Layer

  Begin Layer
   name     = A
   material = Al2024
   width    = 18.2              # at rest
  End Layer

  Begin Layer
   name     = right
   material = Al2024
   width    = 10.0
   xvel     = u_right
  End Layer
 End Stack
End bitwhiz
