#**********************************************************************#
#  U6 example 4: wave-wave interaction (head-on shocks in 2024 Al)     #
#                                                                      #
#  Shock 1 runs right (u_1 = +0.5 km/s, P_1 = 8.351 GPa) and shock 2   #
#  runs left (u_2 = -0.6 km/s, P_2 = 10.245 GPa) through 2024 Al at    #
#  rest ("A"). They collide at x = 10 mm, t = 1.50 us. U6 equation     #
#  sheet, Figs. 8-10; the congruent mirrored Hugoniots give            #
#                                                                      #
#     u_3 = u_1 + u_2 = -0.100 km/s,  P_3 = 20.83 GPa                  #
#                                                                      #
#  (the exact Mie-Gruneisen reshocks give P_3 = 20.81 GPa, which is    #
#  what bitwhiz computes). The stronger left-running shock wins: the   #
#  collided material drifts left, and the contact leans left.          #
#                                                                      #
#  Three slabs make the two shocks: drivers of the same 2024 Al strike #
#  A from both sides at t = 0, at 2u_1 = +1.0 and 2u_2 = -1.2 km/s     #
#  (symmetric impacts give u_1 and u_2 exactly). The impact planes,    #
#  x = 1.0 and 19.2 mm, are placed so that the shocks (U_1 = 5.997,    #
#  U_2 = 6.131 km/s) meet at x = 10 at t = 1.50 us, as in Fig. 10.     #
#  The drivers are 17 mm thick, so neither shock sent back into them   #
#  reaches a free surface before t_end (at 2.83 and 2.77 us): no       #
#  release enters the picture, as in the figure, whose ends are breaks.#
#                                                                      #
#      | left 17.0 =>| A 18.2 (at rest) |<= right 17.0 |               #
#     x=-16.0      x=1.0              x=19.2         x=36.2            #
#                                                                      #
#  Colors: a diverging map (smoothcoolwarm) with the u window from     #
#  -1.0 to +1.0 km/s (plot_u_lo), so u = 0 is the map's neutral middle:#
#  A at rest is gray, u_1 > 0 red, u_2 < 0 blue, and u_3 = -0.1 a      #
#  faint blue, as the sheet's velocity arrows. The right driver        #
#  (-1.2 km/s) takes the blue end color. RS (second order) keeps the   #
#  shocks sharp; plot_dt is under a pixel row.                         #
#                                                                      #
#  Hugoniot: the U6 sheet's values.                                    #
#  Units: mm, us, g/cc, km/s, GPa. Syntax: input/README.md.            #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1
 define u_left  =  1.0          # km/s, left driver:  2 u_1, u_1 = +0.5
 define u_right = -1.2          # km/s, right driver: 2 u_2, u_2 = -0.6

 Begin Run
  title = u6_wave_wave
  t_end = 2.8                   # us, the sheet's Fig. 10 window
 End Run

 Begin Output
  plot_dt   = 0.002             # us between snapshots: under a pixel
                                # row of the t-x diagrams (2.8 us over
                                # 775 rows), so the fronts are not
                                # drawn as stairs
  tracer_dt = 0                 # every cycle
  colormap  = smoothcoolwarm
  plot_u_lo = 0.090909          # u colors from -1.0 km/s: 0.2/2.2 of
                                # the u range (-1.2 to 1.0), so the
                                # window is -1.0 to 1.0 and u = 0 is
                                # its middle

  tracer = left     A@0.25      # x = 5.55: u_1, then u_3
  tracer = collide  10.0        # the collision point: u_3 from 1.50 us
  tracer = right    A@0.75      # x = 14.65: u_2, then u_3
 End Output

 Begin Solver
  method = RS                   # Riemann solver, second order: each
                                # shock about 2 cells wide
 End Solver

 Begin Material Al2024          # 2024 aluminum, the U6 sheet's Hugoniot
  R0 = 2.785
  C0 = 5.328
  S1 = 1.338
  G0 = 2.00
 End Material

 Begin Stack
  resolution = 35               # zones/mm: 595 + 637 + 595 = 1827 cells
  x_left     = -16.0            # left:A at x = 1.0, A:right at x = 19.2

  Begin Layer
   name     = left
   material = Al2024
   width    = 17.0
   xvel     = u_left
  End Layer

  Begin Layer
   name     = A
   material = Al2024
   width    = 18.2              # at rest
  End Layer

  Begin Layer
   name     = right
   material = Al2024
   width    = 17.0
   xvel     = u_right
  End Layer
 End Stack
End bitwhiz
