#**********************************************************************#
#  U6 example 2: wave-boundary interaction, 2024 Al into copper        #
#                                                                      #
#  A shock with u_1 = 0.5 km/s (P_1 = 8.351 GPa) runs right through    #
#  2024 Al ("A") and reaches a bonded interface with Cu ("B") at rest. #
#  U6 equation sheet, Figs. 4, 5 and 7. The impact match               #
#  P_A2(2u_1 - u_2) = P_B(u_2), with A's mirrored Hugoniot, gives      #
#                                                                      #
#     u_2 = 0.307 km/s,  P_2 = 12.07 GPa,  U_B = 4.397 km/s            #
#                                                                      #
#  (the exact Mie-Gruneisen reshock of A gives P_2 = 12.06 GPa, which  #
#  is what bitwhiz computes). Cu has the higher impedance, so a SHOCK  #
#  reflects back into A: state 2 is doubly shocked A.                  #
#                                                                      #
#  The incident shock needs a source: a 2024 Al driver at 2u_1 =       #
#  1.0 km/s strikes A at x = 1 mm at t = 0 (a symmetric impact gives   #
#  u_1 = 0.5 km/s exactly). The shock reaches the interface, x = 10,   #
#  at t = 1.50 us, as in the sheet's Fig. 7. The driver is 17 mm       #
#  thick, so the shock it sends back reaches its free surface only at  #
#  t = 17/5.997 = 2.83 us, after t_end: no release enters the picture, #
#  as in the figure, where A runs off the window.                      #
#                                                                      #
#      | driver 17.0 =>| A 9.0 | B 8.0 |                               #
#     x=-16.0        x=1.0  x=10.0  x=18.0                             #
#                                                                      #
#  RS (second order) keeps the shocks sharp; plot_dt is under a pixel  #
#  row. Where the transmitted shock starts, at the interface, P spikes #
#  for about 50 cycles; the default color range (plot_range = robust)  #
#  leaves the spike out, and the screen reports it.                    #
#                                                                      #
#  Hugoniots: the U6 sheet's values.                                   #
#  Units: mm, us, g/cc, km/s, GPa. Syntax: input/README.md.            #
#**********************************************************************#
Begin bitwhiz
 deck_version = 1
 define u_drive = 1.0           # km/s, the driver: 2 u_1, u_1 = 0.5

 Begin Run
  title = u6_wave_boundary_cu
  t_end = 2.8                   # us, the sheet's Fig. 7 window
 End Run

 Begin Output
  plot_dt   = 0.002             # us between snapshots: under a pixel
                                # row of the t-x diagrams (2.8 us over
                                # 775 rows), so the fronts are not
                                # drawn as stairs
  tracer_dt = 0                 # every cycle
  colormap  = viridis

  tracer = in_a       A@0.75    # x = 7.75: u_1, then u_2 (reflected wave)
  tracer = interface  A:B       # u_2 from t = 1.50 us
  tracer = in_b       B@0.25    # x = 12.0: u_2 behind the transmitted shock
 End Output

 Begin Solver
  method = RS                   # Riemann solver, second order: each
                                # shock about 2 cells wide
 End Solver

 Begin Material Al2024          # 2024 aluminum, the U6 sheet's Hugoniot
  R0 = 2.785
  C0 = 5.328
  S1 = 1.338
  G0 = 2.00
 End Material

 Begin Material Cu
  R0 = 8.930
  C0 = 3.940
  S1 = 1.489
  G0 = 2.00                     # about 2 for copper; it enters only off
                                # the principal Hugoniot
 End Material

 Begin Stack
  resolution = 35               # zones/mm: 595 + 315 + 280 = 1190 cells
  x_left     = -16.0            # driver:A at x = 1, A:B at x = 10

  Begin Layer
   name     = driver
   material = Al2024
   width    = 17.0
   xvel     = u_drive
  End Layer

  Begin Layer
   name     = A
   material = Al2024
   width    = 9.0               # at rest
  End Layer

  Begin Layer
   name     = B
   material = Cu
   width    = 8.0               # at rest
  End Layer
 End Stack
End bitwhiz
